// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  mfaEnabled    Boolean   @default(false)
  lastLoginAt   DateTime?
  preferences   Json      @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  accounts        Account[]
  sessions        Session[]
  businesses      Business[]         @relation("BusinessOwner")
  reviews         Review[]
  favorites       Favorite[]
  collections     Collection[]
  claims          Claim[]           @relation("ClaimUser")
  reviewedClaims  Claim[]           @relation("ClaimReviewer")
  submissions     BusinessSubmission[]  @relation("SubmissionUser")
  reviewedSubmissions BusinessSubmission[] @relation("SubmissionReviewer")
  aiConversations AIConversation[]
  leads           Lead[]
  news            BusinessNews[]
  articles        Article[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// OTP VERIFICATION
// ============================================================================

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  verified  Boolean  @default(false)
  usedAt    DateTime?
  attempts  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, purpose])
  @@index([code])
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// ============================================================================
// BUSINESS DIRECTORY
// ============================================================================

model BusinessType {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  icon        String?
  color       String?
  fields      Json           @default("[]")
  order       Int            @default(0)
  status      ContentStatus  @default(PUBLISHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  categories  Category[]
  businesses  Business[]

  @@index([slug])
  @@index([status])
}

model Category {
  id               String        @id @default(cuid())
  name             String
  slug             String
  description      String?
  image            String?
  icon             String?
  parentId         String?
  businessTypeId   String
  seoTitle         String?
  seoDescription   String?
  faqs             Json          @default("[]")
  order            Int           @default(0)
  status           ContentStatus @default(PUBLISHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  parent        Category?      @relation("CategoryParent", fields: [parentId], references: [id])
  children      Category[]     @relation("CategoryParent")
  businessType  BusinessType   @relation(fields: [businessTypeId], references: [id])
  businesses    Business[]
  services      Service[]
  products      Product[]
  articles      Article[]
  placements    FeaturedPlacement[]

  @@unique([slug, businessTypeId])
  @@index([slug])
  @@index([parentId])
  @@index([businessTypeId])
  @@index([status])
}

model Location {
  id         String       @id @default(cuid())
  name       String
  slug       String
  type       LocationType
  parentId   String?
  latitude   Float?
  longitude  Float?
  population Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  parent           Location?            @relation("LocationParent", fields: [parentId], references: [id])
  children         Location[]           @relation("LocationParent")
  businesses       Business[]
  placements       FeaturedPlacement[]
  searchEvents     SearchEvent[]

  @@unique([slug, parentId])
  @@index([slug])
  @@index([parentId])
  @@index([type])
}

model Business {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  description        String?            @db.Text
  shortDescription  String?
  logo               String?
  coverImage         String?
  email              String?
  phone              String?
  website            String?
  socialLinks        Json               @default("{}")
  yearEstablished    Int?
  priceRange         Int?               @default(2)
  languages          String[]           @default([])
  paymentMethods     String[]           @default([])
  verificationStatus VerificationStatus @default(UNVERIFIED)
  claimedStatus      ClaimStatus        @default(NONE)
  featuredStatus     FeaturedStatus     @default(NONE)
  rating             Float              @default(0)
  reviewCount        Int                @default(0)
  viewCount          Int                @default(0)
  likeCount          Int                @default(0)
  qualityScore       Int                @default(0)
  address            String?
  latitude           Float?
  longitude          Float?
  city               String?
  state              String?
  country            String?
  postalCode         String?
  serviceAreas       String[]          @default([])
  customAttributes   Json               @default("{}")
  metadata           Json               @default("{}")

  // Relations
  businessTypeId     String
  categoryId         String?
  primaryLocationId  String?
  ownerId            String?

  lastVerifiedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  // Relations
  businessType    BusinessType       @relation(fields: [businessTypeId], references: [id])
  category        Category?          @relation(fields: [categoryId], references: [id])
  primaryLocation Location?           @relation(fields: [primaryLocationId], references: [id])
  owner           User?               @relation("BusinessOwner", fields: [ownerId], references: [id])
  branches        BusinessBranch[]
  services        Service[]
  products        Product[]
  offers          Offer[]
  news            BusinessNews[]
  events          BusinessEvent[]
  reviews         Review[]
  hours           BusinessHours[]
  leads           Lead[]
  favorites       Favorite[]
  collections     CollectionItem[]
  placements      FeaturedPlacement[]
  claims          Claim[]
  submissions     BusinessSubmission[]
  views           BusinessView[]
  likes           BusinessLike[]
  amenities       BusinessAmenity[]
  facilities      BusinessFacility[]
  gallery         BusinessGallery[]
  reports         BusinessReport[]
  faqs            BusinessFaq[]

  @@index([slug])
  @@index([businessTypeId])
  @@index([categoryId])
  @@index([ownerId])
  @@index([verificationStatus])
  @@index([claimedStatus])
  @@index([featuredStatus])
  @@index([rating])
  @@index([city])
  @@index([state])
  @@index([country])
  @@index([deletedAt])
  @@index([createdAt])

  // Full text search index
  @@index([name, description])
}

model BusinessView {
  id         String   @id @default(cuid())
  businessId String
  ipAddress  String
  viewedAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([ipAddress])
  @@index([viewedAt])
}

model BusinessLike {
  id         String   @id @default(cuid())
  businessId String
  ipAddress  String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, ipAddress])
  @@index([businessId])
  @@index([ipAddress])
}

model Amenity {
  id          String        @id @default(cuid())
  name        String        @unique
  icon        String?
  category    String?       // e.g., "room", "property", "general"
  order       Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses BusinessAmenity[]

  @@index([category])
}

model Facility {
  id          String        @id @default(cuid())
  name        String        @unique
  icon        String?
  category    String?       // e.g., "wellness", "dining", "recreation"
  order       Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses BusinessFacility[]

  @@index([category])
}

model BusinessAmenity {
  id         String   @id @default(cuid())
  businessId String
  amenityId  String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([businessId, amenityId])
  @@index([businessId])
  @@index([amenityId])
}

model BusinessFacility {
  id         String   @id @default(cuid())
  businessId String
  facilityId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([businessId, facilityId])
  @@index([businessId])
  @@index([facilityId])
}

model BusinessReport {
  id         String          @id @default(cuid())
  businessId String
  reason     ReportReason
  description String?        @db.Text
  reporterIp String
  status     ReportStatus    @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}

model BusinessGallery {
  id         String   @id @default(cuid())
  businessId String
  url        String
  caption    String?
  order      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([order])
}

model BusinessFaq {
  id         String   @id @default(cuid())
  businessId String
  question   String
  answer     String
  order      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([order])
}

model BusinessBranch {
  id         String  @id @default(cuid())
  businessId String
  name       String
  address    String
  phone      String?
  email      String?
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  hours BusinessHours[]
  businessRelation Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessHours {
  id         String  @id @default(cuid())
  businessId String?
  branchId   String?
  dayOfWeek  Int     // 0 = Sunday, 1 = Monday, etc.
  openTime   String? // "09:00"
  closeTime  String? // "18:00"
  isClosed   Boolean @default(false)
  specialHours Json? @default("[]")

  // Relations
  business Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   BusinessBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([businessId, branchId, dayOfWeek])
  @@index([businessId])
  @@index([branchId])
}

// ============================================================================
// SERVICES, PRODUCTS, OFFERS
// ============================================================================

model Service {
  id            String        @id @default(cuid())
  businessId    String
  categoryId    String?
  name          String
  slug          String
  description   String?       @db.Text
  startingPrice Float?
  pricingType   PricingType   @default(FIXED)
  duration      Int?         // minutes
  availability  String?
  serviceArea   String?
  bookingUrl    String?
  images        String[]      @default([])
  status        ContentStatus @default(PUBLISHED)
  order         Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([slug, businessId])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
}

model Product {
  id           String              @id @default(cuid())
  businessId   String
  categoryId   String?
  name         String
  slug         String
  description  String?            @db.Text
  brand        String?
  sku          String?
  price        Float?
  salePrice    Float?
  currency     String             @default("USD")
  availability ProductAvailability @default(IN_STOCK)
  images       String[]           @default([])
  productUrl   String?
  featured     Boolean            @default(false)
  status       ContentStatus      @default(PUBLISHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([slug, businessId])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

model Offer {
  id            String        @id @default(cuid())
  businessId    String
  title         String
  slug          String        @unique
  description   String?       @db.Text
  discountType  DiscountType
  discountValue Float?
  originalPrice Float?
  offerPrice    Float?
  couponCode    String?
  terms         String?       @db.Text
  image         String?
  url           String?
  startDate     DateTime      @default(now())
  endDate       DateTime
  views         Int           @default(0)
  clicks        Int           @default(0)
  redemptions   Int           @default(0)
  status        ContentStatus @default(PUBLISHED)
  isFeatured    Boolean       @default(false)
  isExclusive   Boolean       @default(false)
  isVerified    Boolean       @default(false)
  redeemType    RedeemType    @default(ONLINE_AND_INSTORE)
  redeemLink    String?       // Direct URL to redeem online (overrides business.website when online)
  redeemInstructions String?  @db.Text  // Custom step-by-step instructions for redeeming this offer
  minPurchase   Float?
  maxRedemptions Int?
  perUserLimit  Int?
  applicableDays String[]     @default([])
  tags          String[]      @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([isFeatured])
  @@index([redeemType])
}

enum RedeemType {
  ONLINE
  IN_STORE
  ONLINE_AND_INSTORE
  PHONE
  EMAIL
  COUPON_CODE
  APP_ONLY
}

// ============================================================================
// BUSINESS NEWS & EVENTS
// ============================================================================

model BusinessNews {
  id             String        @id @default(cuid())
  businessId     String
  authorId       String?
  title          String
  slug           String
  summary        String?
  content        String        @db.Text
  featuredImage  String?
  publishDate    DateTime      @default(now())
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  views          Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id])

  @@unique([slug, businessId])
  @@index([businessId])
  @@index([status])
  @@index([publishDate])
}

model BusinessEvent {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  location    String?
  ticketUrl   String?
  image       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([startDate])
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id             String       @id @default(cuid())
  businessId     String
  userId         String?
  rating         Int
  title          String?
  content        String?      @db.Text
  images         String[]    @default([])
  status         ReviewStatus @default(PENDING)
  helpfulCount   Int          @default(0)
  reportCount    Int          @default(0)
  adminResponse  String?      @db.Text
  responseDate   DateTime?
  ipAddress      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user    User?      @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
}

// ============================================================================
// FAVORITES & COLLECTIONS
// ============================================================================

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  businessId String

  createdAt DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businesses CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  businessId   String
  order        Int        @default(0)

  createdAt DateTime @default(now())

  // Relations
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([collectionId, businessId])
  @@index([collectionId])
  @@index([businessId])
}

// ============================================================================
// CLAIMS & SUBMISSIONS
// ============================================================================

model Claim {
  id                String     @id @default(cuid())
  businessId        String
  userId            String
  status            ClaimStatus @default(PENDING)
  verificationMethod String?
  notes             String?
  reviewedAt        DateTime?
  reviewedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user      User     @relation("ClaimUser", fields: [userId], references: [id])
  reviewedBy User?   @relation("ClaimReviewer", fields: [reviewedById], references: [id])

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@index([status])
}

model BusinessSubmission {
  id         String     @id @default(cuid())
  businessId String?
  userId     String?
  data       Json
  status     ClaimStatus @default(PENDING)
  submittedAt DateTime  @default(now())
  reviewedAt DateTime?
  reviewedById String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user       User?     @relation("SubmissionUser", fields: [userId], references: [id])
  reviewedBy User?    @relation("SubmissionReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([submittedAt])
}

// ============================================================================
// SEARCH & ANALYTICS
// ============================================================================

model SearchEvent {
  id             String     @id @default(cuid())
  query          String
  filters        Json       @default("{}")
  locationQuery  String?
  locationId     String?
  userId         String?
  resultsCount   Int        @default(0)
  clickedBusinessId String?
  searchType     SearchType @default(MANUAL)
  sessionId      String?

  createdAt DateTime @default(now())

  // Relations
  location Location? @relation(fields: [locationId], references: [id])

  @@index([query])
  @@index([locationId])
  @@index([searchType])
  @@index([createdAt])
  @@index([clickedBusinessId])
}

model AIConversation {
  id       String    @id @default(cuid())
  userId   String?
  messages Json      @default("[]")
  context  Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// LEADS & PLACEMENTS
// ============================================================================

model Lead {
  id         String   @id @default(cuid())
  businessId String
  type       LeadType
  userId     String?
  metadata   Json     @default("{}")

  createdAt DateTime @default(now())

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([type])
  @@index([createdAt])
}

model FeaturedPlacement {
  id         String    @id @default(cuid())
  businessId String
  startDate  DateTime
  endDate    DateTime
  categoryId String?
  locationId String?
  priority   Int       @default(0)
  label      String?

  createdAt DateTime @default(now())

  // Relations
  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])

  @@index([businessId])
  @@index([categoryId])
  @@index([locationId])
  @@index([startDate, endDate])
}

// ============================================================================
// CONTENT (Articles/FAQs)
// ============================================================================

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  content        String        @db.Text
  excerpt        String?
  featuredImage  String?
  categoryId     String?
  authorId       String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  views          Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  category Category? @relation(fields: [categoryId], references: [id])
  author   User?     @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
}

// ============================================================================
// NOTIFICATIONS & AUDIT
// ============================================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  type   String
  title  String
  message String
  data   Json   @default("{}")
  read   Boolean @default(false)

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model AuditLog {
  id         String  @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    Json   @default("{}")
  ipAddress  String?

  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model SiteSettings {
  id              String    @id @default("site_settings")
  siteName        String?   @default("IndexOrbit")
  siteDescription String?
  tagline         String?   @default("Discover local businesses with AI-powered search")
  ctaTitle        String?   @default("Own a Business?")
  ctaDescription  String?   @default("List your business on IndexOrbit and reach thousands of potential customers")
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?
  socialTwitter   String?
  socialFacebook  String?
  socialInstagram String?
  socialLinkedin  String?
  newsletterTitle String?   @default("Stay updated")
  newsletterDesc  String?   @default("Get the latest business listings and updates delivered to your inbox.")
  footerBrandDesc String?   @default("Discover local businesses with AI-powered search. Find restaurants, hotels, shops, service providers, and more in your area.")
  heroImage       String?   @default("https://images.unsplash.com/photo-1449824913935-59a10b8d2000?w=1920&q=80")
  popularSearches Json?     @default("[\"restaurants near me\",\"hotels in downtown\",\"best coffee shops\",\"24 hour gyms\"]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("SiteSettings")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
